<Window x:Class="_3itx_launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="3itx UI"
        Width="900" Height="580"
        MinWidth="700" MinHeight="450"
        WindowStyle="None"
        Background="#0a0a0c"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Native WPF Title Bar (always draggable) -->
        <Grid Grid.Row="0" Background="#0c0c0e"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Title text -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <TextBlock Text="Synapse Z"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           Foreground="#71717a"
                           VerticalAlignment="Center" />
                <TextBlock Text=" · "
                           FontFamily="Segoe UI"
                           FontSize="11"
                           Foreground="#3f3f46"
                           VerticalAlignment="Center" />
                <TextBlock Text="3itx"
                           FontFamily="Segoe UI"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="#a1a1aa"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Window buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnMinimize" Click="Minimize_Click"
                        Width="46" Height="32"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#71717a" FontSize="10" Cursor="Arrow">
                    <Path Data="M0,0 L10,0" Stroke="#71717a" StrokeThickness="1" />
                </Button>
                <Button x:Name="BtnMaximize" Click="Maximize_Click"
                        Width="46" Height="32"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#71717a" FontSize="10" Cursor="Arrow">
                    <Rectangle Width="9" Height="9" Stroke="#71717a" StrokeThickness="1" Fill="Transparent" />
                </Button>
                <Button x:Name="BtnClose" Click="Close_Click"
                        Width="46" Height="32"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#71717a" FontSize="10" Cursor="Arrow">
                    <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="#71717a" StrokeThickness="1" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Border line under title -->
        <Border Grid.Row="0" VerticalAlignment="Bottom"
                Height="1" Background="#1a1a1e" />

        <!-- WebView2 -->
        <wv2:WebView2 x:Name="WebView"
                      Grid.Row="1"
                      Visibility="Collapsed"
                      DefaultBackgroundColor="#0a0a0c" />

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" Grid.Row="0" Grid.RowSpan="2" Background="#0a0a0c">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                <!-- Title -->
                <TextBlock Text="3 I T X   U I"
                           FontFamily="Segoe UI"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="#e4e4e7"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,40" />

                <!-- Train Station Steps -->
                <Grid HorizontalAlignment="Center" Margin="0,0,0,32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Step 1: Updates -->
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <Ellipse x:Name="Step1Dot" Width="14" Height="14" Fill="#2a2a30" Stroke="#3f3f46" StrokeThickness="2" />
                        <TextBlock x:Name="Step1Label" Text="Updates" FontFamily="Segoe UI" FontSize="9"
                                   Foreground="#52525b" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>

                    <!-- Line 1-2 -->
                    <Border x:Name="Line12" Grid.Column="1" Width="40" Height="2" Background="#2a2a30"
                            VerticalAlignment="Top" Margin="0,6,0,0" />

                    <!-- Step 2: UI Check -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <Ellipse x:Name="Step2Dot" Width="14" Height="14" Fill="#2a2a30" Stroke="#3f3f46" StrokeThickness="2" />
                        <TextBlock x:Name="Step2Label" Text="UI Check" FontFamily="Segoe UI" FontSize="9"
                                   Foreground="#52525b" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>

                    <!-- Line 2-3 -->
                    <Border x:Name="Line23" Grid.Column="3" Width="40" Height="2" Background="#2a2a30"
                            VerticalAlignment="Top" Margin="0,6,0,0" />

                    <!-- Step 3: Server -->
                    <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                        <Ellipse x:Name="Step3Dot" Width="14" Height="14" Fill="#2a2a30" Stroke="#3f3f46" StrokeThickness="2" />
                        <TextBlock x:Name="Step3Label" Text="Server" FontFamily="Segoe UI" FontSize="9"
                                   Foreground="#52525b" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>

                    <!-- Line 3-4 -->
                    <Border x:Name="Line34" Grid.Column="5" Width="40" Height="2" Background="#2a2a30"
                            VerticalAlignment="Top" Margin="0,6,0,0" />

                    <!-- Step 4: Loading -->
                    <StackPanel Grid.Column="6" HorizontalAlignment="Center">
                        <Ellipse x:Name="Step4Dot" Width="14" Height="14" Fill="#2a2a30" Stroke="#3f3f46" StrokeThickness="2" />
                        <TextBlock x:Name="Step4Label" Text="Loading" FontFamily="Segoe UI" FontSize="9"
                                   Foreground="#52525b" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>

                    <!-- Line 4-5 -->
                    <Border x:Name="Line45" Grid.Column="7" Width="40" Height="2" Background="#2a2a30"
                            VerticalAlignment="Top" Margin="0,6,0,0" />

                    <!-- Step 5: Ready -->
                    <StackPanel Grid.Column="8" HorizontalAlignment="Center">
                        <Ellipse x:Name="Step5Dot" Width="14" Height="14" Fill="#2a2a30" Stroke="#3f3f46" StrokeThickness="2" />
                        <TextBlock x:Name="Step5Label" Text="Ready" FontFamily="Segoe UI" FontSize="9"
                                   Foreground="#52525b" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Spinner (small, below steps) -->
                <Grid Width="24" Height="24" Margin="0,0,0,14" HorizontalAlignment="Center">
                    <Ellipse Width="24" Height="24" Stroke="#2a2a30" StrokeThickness="2" Fill="Transparent" />
                    <Ellipse Width="24" Height="24" StrokeThickness="2" Fill="Transparent"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.Stroke>
                            <LinearGradientBrush>
                                <GradientStop Color="#e4e4e7" Offset="0" />
                                <GradientStop Color="Transparent" Offset="0.7" />
                            </LinearGradientBrush>
                        </Ellipse.Stroke>
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotation" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>

                <!-- Status text -->
                <TextBlock x:Name="StatusText"
                           Text="Initializing..."
                           FontFamily="Segoe UI" FontSize="10"
                           Foreground="#71717a"
                           HorizontalAlignment="Center" />

            </StackPanel>
        </Grid>

        <!-- WEAO Status Warning Overlay (Synapse Z not updated) -->
        <Grid x:Name="WeaoOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed">
            <!-- Dark blur backdrop -->
            <Border Background="#CC0a0a0c" />

            <!-- Centered warning card -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#18181b" CornerRadius="12"
                    BorderBrush="#3f3f46" BorderThickness="1"
                    MaxWidth="420" Padding="32,28">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Color="Black" Opacity="0.6" />
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">

                    <!-- Warning Icon -->
                    <Grid Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <Ellipse Width="48" Height="48" Fill="#2a1a10" />
                        <Path Data="M24,8 L43,40 L5,40 Z"
                              Stroke="#f59e0b" StrokeThickness="2" Fill="Transparent"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Width="28" Height="24" Stretch="Uniform" />
                        <TextBlock Text="!" FontFamily="Segoe UI" FontSize="16" FontWeight="Bold"
                                   Foreground="#f59e0b" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Margin="0,5,0,0" />
                    </Grid>

                    <!-- Title -->
                    <TextBlock Text="Synapse Z Status Warning"
                               FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold"
                               Foreground="#fafafa" HorizontalAlignment="Center"
                               Margin="0,0,0,10" />

                    <!-- Message -->
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center"
                               FontFamily="Segoe UI" FontSize="12"
                               Foreground="#a1a1aa" HorizontalAlignment="Center"
                               Margin="0,0,0,24"
                               Text="It seems like Synapse Z is currently not updated to the latest version. Some features may not work properly. Would you still like to continue?" />

                    <!-- Red Continue Button -->
                    <Button x:Name="BtnWeaoContinue" Click="WeaoContinue_Click"
                            Cursor="Hand"
                            HorizontalAlignment="Center"
                            Padding="28,10" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BtnBg" Background="#dc2626" CornerRadius="8"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBg" Property="Background" Value="#b91c1c" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="BtnBg" Property="Background" Value="#991b1b" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="Continue Anyway" Foreground="White" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
