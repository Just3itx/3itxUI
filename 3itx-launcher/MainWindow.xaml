<Window x:Class="_3itx_launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="3itx UI" Width="900" Height="580" MinWidth="700" MinHeight="450"
        WindowStyle="None" Background="#050505" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" SnapsToDevicePixels="True" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ZZZ Background Stripes ↗ -->
        <LinearGradientBrush x:Key="BgStripeUp" MappingMode="Absolute" SpreadMethod="Repeat" StartPoint="0,16" EndPoint="16,0">
            <GradientStop Color="#0d0d0d" Offset="0"/>
            <GradientStop Color="#0d0d0d" Offset="0.5"/>
            <GradientStop Color="#030303" Offset="0.5"/>
            <GradientStop Color="#030303" Offset="1"/>
        </LinearGradientBrush>
        <!-- ZZZ Background Stripes ↘ -->
        <LinearGradientBrush x:Key="BgStripeDown" MappingMode="Absolute" SpreadMethod="Repeat" StartPoint="0,0" EndPoint="16,16">
            <GradientStop Color="#0d0d0d" Offset="0"/>
            <GradientStop Color="#0d0d0d" Offset="0.5"/>
            <GradientStop Color="#030303" Offset="0.5"/>
            <GradientStop Color="#030303" Offset="1"/>
        </LinearGradientBrush>
        <!-- Ribbon Interior Stripes ↘ (Thick) -->
        <LinearGradientBrush x:Key="RibbonStripe" MappingMode="Absolute" SpreadMethod="Repeat" StartPoint="0,24" EndPoint="24,0">
            <GradientStop Color="#3a3a3a" Offset="0"/>
            <GradientStop Color="#3a3a3a" Offset="0.5"/>
            <GradientStop Color="Transparent" Offset="0.5"/>
            <GradientStop Color="Transparent" Offset="1"/>
        </LinearGradientBrush>

        <!-- Common Style for Ribbon TextBlocks to save space -->
        <Style x:Key="RibbonText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Arial Black"/>
            <Setter Property="FontSize" Value="56"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid Grid.Row="0" Background="#080808" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <TextBlock Text="Synapse Z" FontFamily="pack://application:,,,/Fonts/#JetBrains Mono" FontSize="11" Foreground="#71717a" VerticalAlignment="Center"/>
                <TextBlock Text=" · " FontFamily="pack://application:,,,/Fonts/#JetBrains Mono" FontSize="11" Foreground="#3f3f46" VerticalAlignment="Center"/>
                <TextBlock Text="3itx" FontFamily="pack://application:,,,/Fonts/#JetBrains Mono" FontSize="11" FontWeight="SemiBold" Foreground="#a1a1aa" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnMinimize" Click="Minimize_Click" Width="46" Height="32" Background="Transparent" BorderThickness="0" Cursor="Arrow">
                    <Path Data="M0,0 L10,0" Stroke="#71717a" StrokeThickness="1"/>
                </Button>
                <Button x:Name="BtnMaximize" Click="Maximize_Click" Width="46" Height="32" Background="Transparent" BorderThickness="0" Cursor="Arrow">
                    <Rectangle Width="9" Height="9" Stroke="#71717a" StrokeThickness="1" Fill="Transparent"/>
                </Button>
                <Button x:Name="BtnClose" Click="Close_Click" Width="46" Height="32" Background="Transparent" BorderThickness="0" Cursor="Arrow">
                    <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="#71717a" StrokeThickness="1"/>
                </Button>
            </StackPanel>
        </Grid>
        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="#111111"/>

        <!-- WebView2 -->
        <wv2:WebView2 x:Name="WebView" Grid.Row="1" Margin="1,0,1,1" Visibility="Collapsed" DefaultBackgroundColor="#050505"/>

        <!-- ═══════ ZZZ Loading Overlay ═══════ -->
        <Grid x:Name="LoadingOverlay" Grid.Row="0" Grid.RowSpan="2" ClipToBounds="True" Background="#020202">

            <!-- ZZZ Checkerboard Background -->
            <UniformGrid Rows="4" Columns="5" Opacity="0.8">
                <Border Background="{StaticResource BgStripeUp}"/><Border Background="#050505"/><Border Background="{StaticResource BgStripeUp}"/><Border Background="#050505"/><Border Background="{StaticResource BgStripeUp}"/>
                <Border Background="#050505"/><Border Background="{StaticResource BgStripeDown}"/><Border Background="#050505"/><Border Background="{StaticResource BgStripeDown}"/><Border Background="#050505"/>
                <Border Background="{StaticResource BgStripeUp}"/><Border Background="#050505"/><Border Background="{StaticResource BgStripeUp}"/><Border Background="#050505"/><Border Background="{StaticResource BgStripeUp}"/>
                <Border Background="#050505"/><Border Background="{StaticResource BgStripeDown}"/><Border Background="#050505"/><Border Background="{StaticResource BgStripeDown}"/><Border Background="#050505"/>
            </UniformGrid>

            <!-- ZZZ Ribbons -->
            <!-- ZZZ Ribbons -->
            <Grid IsHitTestVisible="False" x:Name="RibbonCanvas">

                <!-- 1. Ribbon 0: BOTTOM (Smallest, steepest angles) -->
                <!-- Base Width 285, translates -285 -->
                <Border VerticalAlignment="Top" Margin="-200,450,-800,0" Height="28" Opacity="0.65" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <RotateTransform Angle="-22"/>
                    </Border.RenderTransform>
                    <Border.Background>
                        <VisualBrush TileMode="Tile" Viewport="0,0,570,28" ViewportUnits="Absolute">
                            <VisualBrush.Transform>
                                <TranslateTransform x:Name="Ribbon0Translate"/>
                            </VisualBrush.Transform>
                            <VisualBrush.Visual>
                                <StackPanel Orientation="Horizontal" Width="570" Height="28" Background="Transparent" VerticalAlignment="Center">
                                    <!-- FIRST LOOP COPY -->
                                    <Border BorderBrush="#1a1a1a" BorderThickness="2" Width="90" Background="#1a1a1a" CornerRadius="2" Margin="0,0,5,0">
                                        <TextBlock Style="{StaticResource RibbonText}" Text="LOADING" Foreground="#060606" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                    </Border>
                                    <Border BorderBrush="#1a1a1a" BorderThickness="2" Width="135" CornerRadius="2" Margin="0,0,5,0">
                                        <Border Background="{StaticResource RibbonStripe}" CornerRadius="2" ClipToBounds="True"/>
                                    </Border>
                                    <!-- 2 Small Vertical Stripe Carts -->
                                    <Border BorderBrush="#1a1a1a" BorderThickness="2" Width="20" CornerRadius="2" Margin="0,0,5,0">
                                        <Border Background="{StaticResource RibbonStripe}" CornerRadius="2" ClipToBounds="True"/>
                                    </Border>
                                    <Border BorderBrush="#1a1a1a" BorderThickness="2" Width="20" CornerRadius="2" Margin="0,0,5,0">
                                        <Border Background="{StaticResource RibbonStripe}" CornerRadius="2" ClipToBounds="True"/>
                                    </Border>

                                    <!-- SECOND LOOP COPY -->
                                    <Border BorderBrush="#1a1a1a" BorderThickness="2" Width="90" Background="#1a1a1a" CornerRadius="2" Margin="0,0,5,0">
                                        <TextBlock Style="{StaticResource RibbonText}" Text="LOADING" Foreground="#060606" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                    </Border>
                                    <Border BorderBrush="#1a1a1a" BorderThickness="2" Width="135" CornerRadius="2" Margin="0,0,5,0">
                                        <Border Background="{StaticResource RibbonStripe}" CornerRadius="2" ClipToBounds="True"/>
                                    </Border>
                                    <!-- 2 Small Vertical Stripe Carts -->
                                    <Border BorderBrush="#1a1a1a" BorderThickness="2" Width="20" CornerRadius="2" Margin="0,0,5,0">
                                        <Border Background="{StaticResource RibbonStripe}" CornerRadius="2" ClipToBounds="True"/>
                                    </Border>
                                    <Border BorderBrush="#1a1a1a" BorderThickness="2" Width="20" CornerRadius="2" Margin="0,0,5,0">
                                        <Border Background="{StaticResource RibbonStripe}" CornerRadius="2" ClipToBounds="True"/>
                                    </Border>
                                </StackPanel>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Border.Background>
                </Border>

                <!-- 2. Ribbon 1: MIDDLE (Medium, intersects bottom and top) -->
                <!-- Base Width 428, translates -428 -->
                <Border VerticalAlignment="Top" Margin="-200,320,-800,0" Height="42" Opacity="0.8" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <RotateTransform Angle="14"/>
                    </Border.RenderTransform>
                    <Border.Background>
                        <VisualBrush TileMode="Tile" Viewport="0,0,856,42" ViewportUnits="Absolute">
                            <VisualBrush.Transform>
                                <TranslateTransform x:Name="Ribbon1Translate"/>
                            </VisualBrush.Transform>
                            <VisualBrush.Visual>
                                <StackPanel Orientation="Horizontal" Width="856" Height="42" Background="Transparent" VerticalAlignment="Center">
                                    <!-- FIRST LOOP COPY -->
                                    <Border BorderBrush="#2a2a2a" BorderThickness="3" Width="140" Background="#2a2a2a" CornerRadius="3" Margin="0,0,8,0">
                                        <TextBlock Style="{StaticResource RibbonText}" Text="LOADING" Foreground="#080808" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0"/>
                                    </Border>
                                    <Border BorderBrush="#2a2a2a" BorderThickness="3" Width="196" CornerRadius="3" Margin="0,0,8,0">
                                        <Border Background="{StaticResource RibbonStripe}" CornerRadius="3" ClipToBounds="True"/>
                                    </Border>
                                    <!-- 2 Small Vertical Stripe Carts -->
                                    <Border BorderBrush="#2a2a2a" BorderThickness="3" Width="30" CornerRadius="3" Margin="0,0,8,0">
                                        <Border Background="{StaticResource RibbonStripe}" CornerRadius="3" ClipToBounds="True"/>
                                    </Border>
                                    <Border BorderBrush="#2a2a2a" BorderThickness="3" Width="30" CornerRadius="3" Margin="0,0,8,0">
                                        <Border Background="{StaticResource RibbonStripe}" CornerRadius="3" ClipToBounds="True"/>
                                    </Border>

                                    <!-- SECOND LOOP COPY -->
                                    <Border BorderBrush="#2a2a2a" BorderThickness="3" Width="140" Background="#2a2a2a" CornerRadius="3" Margin="0,0,8,0">
                                        <TextBlock Style="{StaticResource RibbonText}" Text="LOADING" Foreground="#080808" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0"/>
                                    </Border>
                                    <Border BorderBrush="#2a2a2a" BorderThickness="3" Width="196" CornerRadius="3" Margin="0,0,8,0">
                                        <Border Background="{StaticResource RibbonStripe}" CornerRadius="3" ClipToBounds="True"/>
                                    </Border>
                                    <!-- 2 Small Vertical Stripe Carts -->
                                    <Border BorderBrush="#2a2a2a" BorderThickness="3" Width="30" CornerRadius="3" Margin="0,0,8,0">
                                        <Border Background="{StaticResource RibbonStripe}" CornerRadius="3" ClipToBounds="True"/>
                                    </Border>
                                    <Border BorderBrush="#2a2a2a" BorderThickness="3" Width="30" CornerRadius="3" Margin="0,0,8,0">
                                        <Border Background="{StaticResource RibbonStripe}" CornerRadius="3" ClipToBounds="True"/>
                                    </Border>
                                </StackPanel>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Border.Background>
                </Border>

                <!-- 3. Ribbon 2: TOP (Largest, flattest angle) -->
                <!-- Base Width 580, translates -580 -->
                <Border VerticalAlignment="Top" Margin="-200,120,-800,0" Height="60" Opacity="0.95" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <RotateTransform Angle="-8"/>
                    </Border.RenderTransform>
                    <Border.Background>
                        <VisualBrush TileMode="Tile" Viewport="0,0,1160,60" ViewportUnits="Absolute">
                            <VisualBrush.Transform>
                                <TranslateTransform x:Name="Ribbon2Translate"/>
                            </VisualBrush.Transform>
                            <VisualBrush.Visual>
                                <StackPanel Orientation="Horizontal" Width="1160" Height="60" Background="Transparent" VerticalAlignment="Center">
                                    <!-- FIRST LOOP COPY -->
                                    <Border BorderBrush="#4a4a4a" BorderThickness="4" Width="200" Background="#4a4a4a" CornerRadius="4" Margin="0,0,10,0">
                                        <TextBlock Style="{StaticResource RibbonText}" Text="LOADING" Foreground="#0a0a0a" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0"/>
                                    </Border>
                                    <Border BorderBrush="#4a4a4a" BorderThickness="4" Width="260" CornerRadius="4" Margin="0,0,10,0">
                                        <Border Background="{StaticResource RibbonStripe}" CornerRadius="4" ClipToBounds="True"/>
                                    </Border>
                                    <!-- 2 Small Vertical Stripe Carts -->
                                    <Border BorderBrush="#4a4a4a" BorderThickness="4" Width="40" CornerRadius="4" Margin="0,0,10,0">
                                        <Border Background="{StaticResource RibbonStripe}" CornerRadius="4" ClipToBounds="True"/>
                                    </Border>
                                    <Border BorderBrush="#4a4a4a" BorderThickness="4" Width="40" CornerRadius="4" Margin="0,0,10,0">
                                        <Border Background="{StaticResource RibbonStripe}" CornerRadius="4" ClipToBounds="True"/>
                                    </Border>

                                    <!-- SECOND LOOP COPY -->
                                    <Border BorderBrush="#4a4a4a" BorderThickness="4" Width="200" Background="#4a4a4a" CornerRadius="4" Margin="0,0,10,0">
                                        <TextBlock Style="{StaticResource RibbonText}" Text="LOADING" Foreground="#0a0a0a" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0"/>
                                    </Border>
                                    <Border BorderBrush="#4a4a4a" BorderThickness="4" Width="260" CornerRadius="4" Margin="0,0,10,0">
                                        <Border Background="{StaticResource RibbonStripe}" CornerRadius="4" ClipToBounds="True"/>
                                    </Border>
                                    <!-- 2 Small Vertical Stripe Carts -->
                                    <Border BorderBrush="#4a4a4a" BorderThickness="4" Width="40" CornerRadius="4" Margin="0,0,10,0">
                                        <Border Background="{StaticResource RibbonStripe}" CornerRadius="4" ClipToBounds="True"/>
                                    </Border>
                                    <Border BorderBrush="#4a4a4a" BorderThickness="4" Width="40" CornerRadius="4" Margin="0,0,10,0">
                                        <Border Background="{StaticResource RibbonStripe}" CornerRadius="4" ClipToBounds="True"/>
                                    </Border>
                                </StackPanel>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Border.Background>
                </Border>
            </Grid>

            <!-- ZZZ Minimal Progress Bar and Odometer -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Background="#050505" BorderBrush="#d4d4d8" BorderThickness="2" Padding="6,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ProgressNumber" Text="0" 
                                   FontFamily="pack://application:,,,/Fonts/#JetBrains Mono" FontSize="18" FontWeight="Bold"
                                   Foreground="#ffffff" VerticalAlignment="Center" Margin="2,0,8,0" Width="36" TextAlignment="Right"/>
                        <Rectangle Width="2" Fill="#d4d4d8" Margin="0,3,8,3"/>
                        <StackPanel x:Name="ProgressBarBlocks" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Odometer Text Container (Clipped for animation) -->
                <Border Height="18" ClipToBounds="True" Margin="0,4,0,0">
                    <TextBlock x:Name="StatusTextVisible" Text="LOADING..." 
                               Foreground="#808080" FontSize="11" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Top"
                               FontFamily="pack://application:,,,/Fonts/#JetBrains Mono">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="StatusTextVisibleTranslate" Y="0"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Border>
            </StackPanel>

            <!-- Status Text (hidden visually but kept for C# compatibility if old code uses it) -->
            <TextBlock x:Name="StatusText" Visibility="Collapsed">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="StatusTextTranslate" Y="0"/>
                </TextBlock.RenderTransform>
            </TextBlock>

        </Grid>

        <!-- WEAO Warning Overlay -->
        <Grid x:Name="WeaoOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed">
            <Border Background="#CC0a0a0c"/>
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#18181b" CornerRadius="12"
                    BorderBrush="#3f3f46" BorderThickness="1"
                    MaxWidth="420" Padding="32,28">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Color="Black" Opacity="0.6"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <Grid Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <Ellipse Width="48" Height="48" Fill="#2a1a10"/>
                        <Path Data="M24,8 L43,40 L5,40 Z" Stroke="#f59e0b" StrokeThickness="2" Fill="Transparent"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Width="28" Height="24" Stretch="Uniform"/>
                        <TextBlock Text="!" FontFamily="pack://application:,,,/Fonts/#JetBrains Mono" FontSize="16" FontWeight="Bold"
                                   Foreground="#f59e0b" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,0,0"/>
                    </Grid>
                    <TextBlock Text="Synapse Z Status Warning"
                               FontFamily="pack://application:,,,/Fonts/#JetBrains Mono" FontSize="15" FontWeight="SemiBold"
                               Foreground="#fafafa" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center"
                               FontFamily="pack://application:,,,/Fonts/#JetBrains Mono" FontSize="12"
                               Foreground="#a1a1aa" HorizontalAlignment="Center" Margin="0,0,0,24"
                               Text="It seems like Synapse Z is currently not updated to the latest version. Some features may not work properly. Would you still like to continue?"/>
                    <Button x:Name="BtnWeaoContinue" Click="WeaoContinue_Click"
                            Cursor="Hand" HorizontalAlignment="Center"
                            Padding="28,10" FontFamily="pack://application:,,,/Fonts/#JetBrains Mono" FontSize="12" FontWeight="SemiBold">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BtnBg" Background="#dc2626" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBg" Property="Background" Value="#b91c1c"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="BtnBg" Property="Background" Value="#991b1b"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="Continue Anyway" Foreground="White"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
