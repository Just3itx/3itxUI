<Window x:Class="_3itx_launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="3itx UI"
        Width="900" Height="580"
        MinWidth="700" MinHeight="450"
        WindowStyle="None"
        Background="#0a0a0c"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Native WPF Title Bar (always draggable) -->
        <Grid Grid.Row="0" Background="#0c0c0e"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Title text -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <TextBlock Text="Synapse Z"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           Foreground="#71717a"
                           VerticalAlignment="Center" />
                <TextBlock Text=" · "
                           FontFamily="Segoe UI"
                           FontSize="11"
                           Foreground="#3f3f46"
                           VerticalAlignment="Center" />
                <TextBlock Text="3itx"
                           FontFamily="Segoe UI"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="#a1a1aa"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Window buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnMinimize" Click="Minimize_Click"
                        Width="46" Height="32"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#71717a" FontSize="10" Cursor="Arrow">
                    <Path Data="M0,0 L10,0" Stroke="#71717a" StrokeThickness="1" />
                </Button>
                <Button x:Name="BtnMaximize" Click="Maximize_Click"
                        Width="46" Height="32"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#71717a" FontSize="10" Cursor="Arrow">
                    <Rectangle Width="9" Height="9" Stroke="#71717a" StrokeThickness="1" Fill="Transparent" />
                </Button>
                <Button x:Name="BtnClose" Click="Close_Click"
                        Width="46" Height="32"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#71717a" FontSize="10" Cursor="Arrow">
                    <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="#71717a" StrokeThickness="1" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Border line under title -->
        <Border Grid.Row="0" VerticalAlignment="Bottom"
                Height="1" Background="#1a1a1e" />

        <!-- WebView2 -->
        <wv2:WebView2 x:Name="WebView"
                      Grid.Row="1"
                      Visibility="Collapsed"
                      DefaultBackgroundColor="#0a0a0c" />

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" Grid.Row="0" Grid.RowSpan="2" Background="#0a0a0c">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid Width="56" Height="56" Margin="0,0,0,28">
                    <Ellipse Width="56" Height="56"
                             Stroke="#2a2a30" StrokeThickness="2"
                             Fill="Transparent" />
                    <Ellipse Width="56" Height="56"
                             StrokeThickness="2" Fill="Transparent"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.Stroke>
                            <LinearGradientBrush>
                                <GradientStop Color="#e4e4e7" Offset="0" />
                                <GradientStop Color="Transparent" Offset="0.7" />
                            </LinearGradientBrush>
                        </Ellipse.Stroke>
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotation" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>

                <TextBlock Text="3 I T X   U I"
                           FontFamily="Segoe UI"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="#e4e4e7"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6" />

                <TextBlock x:Name="StatusText"
                           Text="Starting server..."
                           FontFamily="Segoe UI" FontSize="10"
                           Foreground="#71717a"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24" />

                <Border Width="200" Height="2" Background="#1a1a1e" CornerRadius="1">
                    <Border x:Name="ProgressBar"
                            HorizontalAlignment="Left"
                            Width="0" Height="2"
                            Background="#71717a"
                            CornerRadius="1" />
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
