<Window x:Class="_3itx_launcher.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="3itx Notification"
        Width="320" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Focusable="False"
        ShowActivated="False">

    <Border x:Name="CardBorder"
            CornerRadius="8"
            Background="#F00C0C0E"
            BorderBrush="#14FFFFFF"
            BorderThickness="1"
            Margin="8"
            RenderTransformOrigin="1,1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.45" Color="Black"/>
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" X="340"/>
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="3"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Avatar + Name -->
            <Grid Grid.Row="0" Margin="12,10,12,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" Width="34" Height="34" VerticalAlignment="Top"
                         Stroke="#22FFFFFF" StrokeThickness="1">
                    <Ellipse.Fill>
                        <ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill"/>
                    </Ellipse.Fill>
                </Ellipse>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,1">
                        <TextBlock x:Name="DisplayNameText" FontSize="11.5" FontWeight="SemiBold"
                                   FontFamily="Segoe UI" Foreground="#E4E4E7"/>
                        <TextBlock x:Name="UsernameText" FontSize="9" VerticalAlignment="Bottom"
                                   Margin="5,0,0,0.5" FontFamily="Segoe UI" Foreground="#52525B"/>
                    </StackPanel>
                    <TextBlock Text="joined a server" FontSize="9.5" FontFamily="Segoe UI"
                               Foreground="#5CFFFFFF"/>
                </StackPanel>
            </Grid>

            <!-- Row 1: JobId -->
            <StackPanel Grid.Row="1" Margin="12,4,12,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ID" FontSize="8" FontWeight="Medium" FontFamily="Segoe UI"
                               Foreground="#40FFFFFF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="JobIdText" FontSize="9" FontFamily="Consolas"
                               Foreground="#71717A" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Row 2: Timer footer -->
            <Border Grid.Row="2" Padding="12,5" BorderBrush="#10FFFFFF" BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock Text="joined a server" FontSize="9" FontFamily="Segoe UI"
                               Foreground="#40FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TimerText" FontSize="9" FontFamily="Consolas"
                               Foreground="#40FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Row 3: Progress bar -->
            <Canvas Grid.Row="3" ClipToBounds="True">
                <Border x:Name="ProgressBar" Height="3" Canvas.Left="0" Canvas.Top="0"
                        Background="#40FFFFFF" CornerRadius="0,0,0,8"/>
            </Canvas>
        </Grid>
    </Border>
</Window>
