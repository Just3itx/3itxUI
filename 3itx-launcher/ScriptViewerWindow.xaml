<Window x:Class="_3itx_launcher.ScriptViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Script Viewer"
        Width="720" Height="540"
        MinWidth="420" MinHeight="320"
        WindowStyle="None"
        Background="#09090b"
        ResizeMode="CanResize"
        ShowInTaskbar="false"
        Topmost="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="-1"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Border CornerRadius="8" ClipToBounds="True" Margin="1,0,1,1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Background="#0c0c0e"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">

                    <TextBlock x:Name="TitleText"
                               Text="Decompiler"
                               FontFamily="pack://application:,,,/Fonts/#JetBrains Mono"
                               FontSize="11"
                               FontWeight="Medium"
                               Foreground="#a1a1aa"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Toolbar buttons in title bar (right side) -->
                <Button x:Name="CopyBtn" Grid.Column="2" Click="Copy_Click"
                        Height="22" Padding="8,0"
                        Margin="0,0,3,0" Cursor="Hand"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#71717a" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" />
                        <TextBlock Text="Copy" FontFamily="pack://application:,,,/Fonts/#JetBrains Mono" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="InsertBtn" Grid.Column="3" Click="InsertToEditor_Click"
                        Height="22" Padding="8,0"
                        Margin="0,0,3,0" Cursor="Hand"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#71717a" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" />
                        <TextBlock Text="Insert" FontFamily="pack://application:,,,/Fonts/#JetBrains Mono" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="DumpBtn" Grid.Column="4" Click="DumpFunctions_Click"
                        Height="22" Padding="8,0"
                        Margin="0,0,6,0" Cursor="Hand"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#71717a" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" />
                        <TextBlock Text="Dump" FontFamily="pack://application:,,,/Fonts/#JetBrains Mono" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="5" Click="Close_Click"
                        Width="32" Height="32"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#71717a" Cursor="Arrow">
                    <Path Data="M0,0 L7,7 M7,0 L0,7" Stroke="#52525b" StrokeThickness="1.2" />
                </Button>
            </Grid>

            <!-- Border under title -->
            <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="#18181b" />

            <!-- Code WebView -->
            <Grid Grid.Row="1" Background="#09090b">
                <wpf:WebView2 x:Name="CodeWebView" DefaultBackgroundColor="#09090b" />

                <!-- Loading overlay -->
                <Border x:Name="LoadingOverlay"
                        Background="#F009090b"
                        Visibility="Visible">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="⏳ Decompiling..."
                                   Foreground="#71717a"
                                   FontFamily="pack://application:,,,/Fonts/#JetBrains Mono"
                                   FontSize="12"
                                   HorizontalAlignment="Center" />
                        <ProgressBar IsIndeterminate="True"
                                     Width="140" Height="2"
                                     Margin="0,8,0,0"
                                     Foreground="#8b5cf6"
                                     Background="#18181b"
                                     BorderThickness="0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
